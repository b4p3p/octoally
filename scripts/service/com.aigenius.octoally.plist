<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aigenius.octoally</string>

  <!-- Exec through the CLI, not through a node path resolved at install time:
       the CLI finds node at every start (so the agent survives node moving or
       being replaced) and rebuilds the native modules when the ABI changed. -->
  <key>ProgramArguments</key>
  <array>
    <string>__OCTOALLY_DIR__/bin/octoally</string>
    <string>run</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__OCTOALLY_DIR__/server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>42010</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__OCTOALLY_DIR__/logs/octoally.log</string>
  <key>StandardErrorPath</key>
  <string>__OCTOALLY_DIR__/logs/octoally-error.log</string>

  <key>UserName</key>
  <string>__USER__</string>
</dict>
</plist>
