[Unit]
Description=OctoAlly Orchestration Dashboard
After=network.target
# Give up after 5 failures in a minute and land in 'failed', which is visible.
# Without a limit a broken unit stays 'activating' and retries every 5s for
# weeks — that is how a service that could not exec node went unnoticed here.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__OCTOALLY_DIR__/server
# Exec through the CLI, not through a node path resolved at install time: the
# CLI finds node at every start (so the unit survives node moving or being
# replaced) and rebuilds the native modules when the Node ABI changed.
ExecStart=__OCTOALLY_DIR__/bin/octoally run
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=42010
StandardOutput=journal
StandardError=journal

# Graceful shutdown. KillMode=process, not a control-group kill: the tmux
# server that holds every open session is a child of this unit, so cleaning out
# the cgroup takes down the user's terminals, the Claude processes inside them
# and their MCP servers along with the server. That is not theory, it is what a
# `fuser -k` on the port did here: systemd saw status=9/KILL and SIGKILLed
# tmux, claude and every MCP in the group, three sessions at once.
# Signalling the main process alone is enough: the server stops sessions the
# right way on SIGINT (killAllSessions leaves tmux alive for reconnect), and a
# PTY worker whose parent dies exits through its own 'disconnect' handler.
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
